{
  "name": "teatro-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "api": "json-server --watch ../api/db.json --port 3001 --host 0.0.0.0",
    "dev": "concurrently -n api,expo -c yellow,cyan \"pnpm api\" \"pnpm start\"",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.17",
    "@expo/vector-icons": "15.1.1",
    "@hookform/resolvers": "5.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@tanstack/react-query": "5.105.0",
    "axios": "1.21.0",
    "expo": "57.0.31",
    "expo-constants": "57.0.22",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.81.0",
    "react-native": "0.86.3",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.36.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.4",
    "zod": "4.6.6",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/react": "19.2.17",
    "concurrently": "10.0.6",
    "json-server": "0.17.4",
    "typescript": "6.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0"
}
