{
  "expo": {
    "name": "teatro-app",
    "slug": "teatro-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#14090c"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hernan.teatro"
    },
    "android": {
      "package": "com.hernan.teatro",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "El Teatro Colón usa la cámara para capturar el afiche de la obra.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "El Teatro Colón accede a tus fotos para elegir el afiche de la obra.",
          "cameraPermission": "El Teatro Colón usa la cámara para capturar el afiche de la obra.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "El Teatro Colón usa tu ubicación para mostrarte la sede y la distancia al teatro."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#d4a24c",
          "defaultChannel": "teatro-funciones"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "afae9cac-466d-4d8f-bfd4-bec19c76a267"
      }
    },
    "owner": "rbldhernan"
  }
}
