# Variables públicas de Expo. Solo las que empiezan por EXPO_PUBLIC_ llegan al
# bundle: no pongas aquí secretos.
#
# Las tres son OPCIONALES en desarrollo:
# - En desarrollo la app deduce el host de la API desde el host de Expo
#   (emulador, celular en la misma red o web) y usa https://dummyjson.com para
#   la autenticación.
# - Fuera de desarrollo la API debe declararse y usar https://, si no la app
#   falla al arrancar con un mensaje claro.

# URL pública de la API local.
# Solo es necesaria si json-server corre en otro equipo o en otro puerto.
# Ejemplo para celular físico en la misma red:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3001
EXPO_PUBLIC_API_URL=

# URL del servicio de autenticación. Por defecto https://dummyjson.com
EXPO_PUBLIC_AUTH_URL=

# Pon 1 para ver en consola los logger.debug (silenciados por defecto).
EXPO_PUBLIC_VERBOSE_LOGS=
