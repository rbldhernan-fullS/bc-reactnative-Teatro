# URL pública de la API local.
# Solo es necesaria si json-server corre en otro equipo o en otro puerto.
# En desarrollo normal la app detecta automáticamente la IP del host de Expo.
#
# Ejemplo para celular físico en la misma red:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3001
EXPO_PUBLIC_API_URL=
